# Ignore everything at root by default
/*

# Track scripts and project metadata
!/*.py
!/scripts/
!/.gitignore
!/README.md
!/LICENSE
!/boarddocs_unids.json
!/bd_links.js
!/.github/

# Website (Cloudflare Worker): entry point, config, and static assets
!/worker.js
!/wrangler.toml
!/public/

# Docs + changelog (this project is meant to be downloaded and carried forward)
!/CHANGELOG.md
!/docs/
!/VERSION

# Claude Code prompt-capture hook (travels with the repo; not local settings)
!/.claude/
/.claude/settings.local.json

# Transient verifier output — written only when drift is detected, consumed
# by the workflow's issue step, never committed.
verify-report.txt
issue_body.txt
!/resummarize/
!/resummarize/*.json

# Campaign artifacts. The corpus and its backups now live under the repo too, so
# what does and does not reach GitHub is decided here rather than by which folder
# something happens to sit in.
#
#   COMMITTED  manifests, agent output (*_out/), and the D1 payloads (stores/).
#              The agent output is the irreplaceable part -- regenerating it means
#              paying for Opus again -- and resummarize_queue.py derives its
#              done/pending state from it, so a fresh checkout resumes correctly.
#   IGNORED    batch text (regenerable from a manifest's urlmap + the corpus),
#              the corpus itself, and the large local backups.
!/resummarize/*_out/
!/resummarize/*_out/*.json
!/resummarize/stores/
!/resummarize/stores/**/*.json
/resummarize/fanout/
/resummarize/wave2/
/resummarize/remainder/
/data/

# Generated dataset artifacts (scripts/build_dataset.py). Rebuildable from D1 +
# chunks.jsonl in about a minute, 82 MB raw, and served gzipped from R2 -- so
# the repo carries the builder, not its output.
/dataset/
