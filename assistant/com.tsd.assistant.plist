<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tsd.assistant</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/CHANGEME/tsd-boarddocs/assistant/runner.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/CHANGEME/tsd-boarddocs</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/tsd-assistant.log</string>
  <key>StandardErrorPath</key><string>/tmp/tsd-assistant.log</string>
  <!-- PATH must contain the `claude` binary. The installer puts it in ~/.local/bin, which is on
       your PATH interactively via the shell profile and NOT under launchd, which starts from a
       bare environment. Omit it and the runner looks perfectly healthy -- it polls, claims a
       question, flips it to 'answering' -- then fails every answer with "claude: command not
       found", and the question sits unanswered for the 20 minutes it takes to go stale.
       Check `command -v claude` on the machine and make sure its directory is listed here. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/CHANGEME/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
